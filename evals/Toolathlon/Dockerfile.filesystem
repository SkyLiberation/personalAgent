FROM python:3.11-slim-bookworm@sha256:0a310eeecf4e1f5a0743f9a6520c90c88d089c903ca5fd283f501e3a805f5f89

WORKDIR /workspace
ADD --checksum=sha256:48cc0e21e048790e54c0cf5749c2725005313d652651c40b7a21feb9697aaf75 \
    https://nodejs.org/dist/v24.22.2/node-v24.22.2-linux-x64.tar.xz /tmp/node.tar.xz
RUN python -m tarfile -e /tmp/node.tar.xz /opt \
    && rm /tmp/node.tar.xz \
    && ln -s /opt/node-v24.22.2-linux-x64/bin/node /usr/bin/node \
    && node /opt/node-v24.22.2-linux-x64/lib/node_modules/npm/bin/npm-cli.js install \
        --omit=dev --no-save --package-lock=false --ignore-scripts --no-audit --no-fund \
        --engine-strict --fetch-retries=1 --fetch-timeout=30000 \
        @modelcontextprotocol/server-filesystem@2.2.0
