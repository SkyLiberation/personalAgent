PERSONAL_AGENT_DATA_DIR=./data
PERSONAL_AGENT_LOG_LEVEL=INFO
PERSONAL_AGENT_EMBEDDING_PROVIDER=local
PERSONAL_AGENT_LLM_PROVIDER=stub
PERSONAL_AGENT_DEFAULT_USER=default
PERSONAL_AGENT_GRAPHITI_URI=bolt://localhost:7687
PERSONAL_AGENT_GRAPHITI_USER=neo4j
PERSONAL_AGENT_GRAPHITI_PASSWORD=password
PERSONAL_AGENT_GRAPHITI_GROUP_PREFIX=personal-agent
PERSONAL_AGENT_GRAPH_SEARCH_STRATEGY=hybrid_rrf
PERSONAL_AGENT_GRAPH_SEARCH_LIMIT=10
PERSONAL_AGENT_GRAPH_SEARCH_CITATION_LIMIT=20
# Canonical OpenAI-compatible provider for every generative LLM adapter.
# The sibling GPT Researcher tokeness compose profile reads these same values.
STRUCTURED_API_KEY=your_tokeness_api_key_here
STRUCTURED_BASE_URL=https://n.tokeness.io/v1
STRUCTURED_MODEL=gpt-5.4-mini
PERSONAL_AGENT_STRUCTURED_TIMEOUT_SECONDS=60
PERSONAL_AGENT_STRUCTURED_MAX_RETRIES=2
PERSONAL_AGENT_GRAPHITI_LLM_API_KEY=${STRUCTURED_API_KEY}
PERSONAL_AGENT_GRAPHITI_LLM_BASE_URL=${STRUCTURED_BASE_URL}
PERSONAL_AGENT_GRAPHITI_LLM_MODEL=${STRUCTURED_MODEL}
PERSONAL_AGENT_GRAPHITI_LLM_SMALL_MODEL=${STRUCTURED_MODEL}
PERSONAL_AGENT_GRAPH_SYNC_MAX_ATTEMPTS=3
PERSONAL_AGENT_GRAPH_SYNC_INITIAL_BACKOFF_SECONDS=2.0
PERSONAL_AGENT_GRAPH_SYNC_BACKOFF_MULTIPLIER=2.0
PERSONAL_AGENT_GRAPH_SYNC_MAX_BACKOFF_SECONDS=20.0
OPENAI_API_KEY=${STRUCTURED_API_KEY}
OPENAI_BASE_URL=${STRUCTURED_BASE_URL}
OPENAI_MODEL=${STRUCTURED_MODEL}
OPENAI_SMALL_MODEL=${STRUCTURED_MODEL}
OPENAI_VISION_MODEL=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
PERSONAL_AGENT_EXTRACT_API_KEY=${STRUCTURED_API_KEY}
PERSONAL_AGENT_EXTRACT_BASE_URL=${STRUCTURED_BASE_URL}
PERSONAL_AGENT_EXTRACT_MODEL=${STRUCTURED_MODEL}
PERSONAL_AGENT_ASK_GRAPH_PROVIDER=graphiti
PERSONAL_AGENT_MS_GRAPHRAG_ENABLED=false
PERSONAL_AGENT_MS_GRAPHRAG_ROOT=./data/ms_graphrag
PERSONAL_AGENT_MS_GRAPHRAG_EXECUTABLE=graphrag
PERSONAL_AGENT_MS_GRAPHRAG_QUERY_METHOD=local
PERSONAL_AGENT_MS_GRAPHRAG_INDEX_METHOD=standard
PERSONAL_AGENT_MS_GRAPHRAG_RESPONSE_TYPE=Multiple Paragraphs
PERSONAL_AGENT_MS_GRAPHRAG_AUTO_INDEX=false
PERSONAL_AGENT_MS_GRAPHRAG_COMMAND_TIMEOUT_SECONDS=600
PERSONAL_AGENT_MS_GRAPHRAG_COMPLETION_API_KEY=${STRUCTURED_API_KEY}
PERSONAL_AGENT_MS_GRAPHRAG_COMPLETION_API_BASE=${STRUCTURED_BASE_URL}
PERSONAL_AGENT_MS_GRAPHRAG_COMPLETION_MODEL=${STRUCTURED_MODEL}
PERSONAL_AGENT_ASK_RERANKER=heuristic
PERSONAL_AGENT_ASK_CANDIDATE_ENRICHER=parent_child
PERSONAL_AGENT_ASK_PARENT_CHILD_TOP_N=3
PERSONAL_AGENT_ASK_PARENT_CHILD_MIN_OVERLAP=2
PERSONAL_AGENT_ASK_NEIGHBOR_CHUNK_WINDOW=0
PERSONAL_AGENT_ASK_GRAPH_NOTE_EVIDENCE_MODE=all
PERSONAL_AGENT_ASK_GRAPH_NOTE_EVIDENCE_MIN_OVERLAP=2
PERSONAL_AGENT_ASK_CONTEXT_MAX_ITEMS=12
PERSONAL_AGENT_ASK_CONTEXT_CHAR_BUDGET=5000
PERSONAL_AGENT_ASK_LLM_RERANK_TOP_N=20
PERSONAL_AGENT_ASK_LLM_RERANK_TIMEOUT_SECONDS=20
PERSONAL_AGENT_ASK_LLM_RERANK_MODEL=
EMBEDDING_API_KEY=your_siliconflow_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_MS=60000
PERSONAL_AGENT_WEB_SEARCH_PROVIDER=tavily
PERSONAL_AGENT_WEB_SEARCH_API_KEY=your_web_search_api_key_here
PERSONAL_AGENT_WEB_SEARCH_BASE_URL=https://api.tavily.com
PERSONAL_AGENT_WEB_SEARCH_TIMEOUT_MS=60000
PERSONAL_AGENT_GPT_RESEARCHER_A2A_ENABLED=false
PERSONAL_AGENT_GPT_RESEARCHER_A2A_ENDPOINT=http://127.0.0.1:8001/a2a
PERSONAL_AGENT_GPT_RESEARCHER_A2A_AGENT_CARD_URL=http://127.0.0.1:8001/.well-known/agent-card.json
PERSONAL_AGENT_GPT_RESEARCHER_A2A_TIMEOUT_SECONDS=120
PERSONAL_AGENT_GPT_RESEARCHER_A2A_REPORT_TYPE=research_report
PERSONAL_AGENT_GPT_RESEARCHER_A2A_REPORT_SOURCE=web
PERSONAL_AGENT_GPT_RESEARCHER_A2A_TONE=Objective
PERSONAL_AGENT_GPT_RESEARCHER_A2A_MAX_SEARCH_RESULTS=
PERSONAL_AGENT_ENTERPRISE_KNOWLEDGE_RAW_ROOTS=D:/mySoft/workspace/personalWiki/raw
PERSONAL_AGENT_ENTERPRISE_KNOWLEDGE_RAW_GLOBS=*.md
PERSONAL_AGENT_ENTERPRISE_KNOWLEDGE_RAW_MAX_FILE_BYTES=2000000
# Optional GitHub MCP bridge. Uses official Docker stdio server in read-only mode.
PERSONAL_AGENT_GITHUB_MCP_ENABLED=false
GITHUB_PAT=your_github_personal_access_token_here
PERSONAL_AGENT_GITHUB_MCP_TOKEN_ENV=GITHUB_PAT
PERSONAL_AGENT_GITHUB_MCP_TOOLS=search_code,get_file_contents,search_repositories
# Optional Notion MCP bridge. Uses @notionhq/notion-mcp-server stdio with read-only mapped tools.
PERSONAL_AGENT_NOTION_MCP_ENABLED=false
NOTION_TOKEN=your_notion_integration_token_here
PERSONAL_AGENT_NOTION_MCP_TOKEN_ENV=NOTION_TOKEN
PERSONAL_AGENT_NOTION_MCP_TOOLS=API-post-search,API-retrieve-page-markdown
# Read-only release E2E fixture: an explicit non-sensitive Notion test page.
PERSONAL_AGENT_E2E_NOTION_PAGE_ID=
PERSONAL_AGENT_E2E_NOTION_EXPECTED_TEXT=PERSONAL_AGENT_NOTION_E18_MARKER
PERSONAL_AGENT_E2E_MODEL_PROFILE=configured
PERSONAL_AGENT_E2E_MODEL_TIMEOUT_SECONDS=120
# Generic MCP bridge for additional servers.
PERSONAL_AGENT_MCP_SERVERS={"enabled":true,"servers":[{"server_id":"github","transport":"stdio","command":"docker","args":["run","-i","--rm","-e","GITHUB_PERSONAL_ACCESS_TOKEN","-e","GITHUB_READ_ONLY","ghcr.io/github/github-mcp-server"],"env":{"GITHUB_PERSONAL_ACCESS_TOKEN":"${GITHUB_PAT}","GITHUB_READ_ONLY":"1"},"tools":[{"remote_name":"search_code","name":"github.search_code","description":"Search code in GitHub repositories that the configured token can read.","business_role":"enterprise_knowledge_search","side_effects":["external_network"],"permission_scope":"github:repo:read","allowed_domains":["github.com"]},{"remote_name":"get_file_contents","name":"github.get_file_contents","description":"Read file contents from a GitHub repository that the configured token can read.","business_role":"enterprise_knowledge_search","side_effects":["external_network"],"permission_scope":"github:repo:read","allowed_domains":["github.com"]}]}]}
PERSONAL_AGENT_POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/personal_agent?sslmode=disable
PERSONAL_AGENT_FEISHU_ENABLED=false
PERSONAL_AGENT_FEISHU_USE_DEFAULT_USER=true
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_BASE_URL=https://open.feishu.cn

# Research production mode: external cron enqueues, durable worker executes.
# Keep the FastAPI in-process scheduler disabled in multi-process deployments.
PERSONAL_AGENT_RESEARCH_SCHEDULER_ENABLED=false
PERSONAL_AGENT_RESEARCH_SCHEDULER_TICK_SECONDS=60
PERSONAL_AGENT_RESEARCH_MAX_QUERIES=5
PERSONAL_AGENT_RESEARCH_MAX_SEARCH_RESULTS=30
PERSONAL_AGENT_RESEARCH_MAX_FULLTEXT_FETCHES=5
PERSONAL_AGENT_RESEARCH_MAX_TOOL_CALLS=15

# LangSmith observability (disabled by default)
PERSONAL_AGENT_LANGSMITH_ENABLED=false
PERSONAL_AGENT_LANGSMITH_PROJECT=personal-agent-dev
PERSONAL_AGENT_TRACE_UPLOAD_INPUTS=false
PERSONAL_AGENT_TRACE_SAMPLE_RATE=1.0
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
